# Copy this file to .env and fill in real values for local development.
# On Render, set these same names as environment variables in the
# dashboard instead — do not upload a real .env file there.

# Supabase → Project Settings → Database → Connection string → URI
# (use the "Transaction pooler" version if you're deploying to Render,
# since it works better with serverless/ephemeral connections)
DATABASE_URL=postgresql://postgres.oekwpysuemstwisajmlu:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase → Project Settings → API
SUPABASE_URL=https://oekwpysuemstwisajmlu.supabase.co
SUPABASE_KEY=sb_publishable_8xbVlIFxPwt6Rfh0TOMIEA_ApRPFbgi

# Storage bucket name (create this in Supabase → Storage, make it Public)
SUPABASE_BUCKET=ncc-media

# Any long random string — used to sign Flask session cookies
SECRET_KEY=change-this-to-something-random
